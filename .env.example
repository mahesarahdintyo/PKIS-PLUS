# =============================================================================
# PKIS-PLUS Environment Configuration (Local PostgreSQL + Socket.io Server)
# =============================================================================

# 1. Database Connection (PostgreSQL Lokal / Laragon / Docker)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Contoh Laragon: postgresql://postgres:postgres@localhost:5432/pkis_plus?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pkis_plus?schema=public"

# 2. Keamanan & Password Hashing
PASSWORD_SALT="pkis-production-secret-salt-2026-secure"

# 3. Server & Networking
PORT=3000
HOST="0.0.0.0"

# 4. Storage & File Upload
# Direktori penyimpanan file lokal (default: ./public/uploads)
UPLOAD_DIR="./public/uploads"
NEXT_PUBLIC_STORAGE_URL="/uploads"

# 5. Feature Flags
NEXT_PUBLIC_ENABLE_AUTO_POLLING=true

# 6. Web Push Notification (Opsional untuk Panggilan Andon ke HP)
VAPID_PUBLIC_KEY="BCPEeRkRPz2P0UQKWiu1X3nAjZ5C3UrVG4In4KJXw8Z9TGJhHlRxCzxbqPekSEU7M_nOsoitqZr9Ry7Q0bFeNAw"
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:andon@localhost"

# 7. Firebase Cloud Messaging / FCM (Opsional untuk Push Notification ke Android Native)
# Cara mendapatkan nilai ini:
#   1. Buka Firebase Console (console.firebase.google.com)
#   2. Pilih project → Project Settings → Service Accounts
#   3. Klik "Generate new private key" → Download file JSON
#   4. Copy seluruh ISI file JSON tersebut ke dalam satu baris di bawah ini (tanpa newline)
# Jika dikosongkan, fitur FCM Android akan di-skip secara otomatis (tidak error).
FIREBASE_SERVICE_ACCOUNT_JSON=''

# 8. Default Admin Credentials (untuk seed pertama kali)
DEFAULT_ADMIN_EMAIL="admin@pabrik.local"
DEFAULT_ADMIN_PASSWORD="admin"
